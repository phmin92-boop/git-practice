    "import datetime as dt\n",
    "\n",
    "now = dt.datetime.now()\n",
    "today = dt.date.today()\n",
    "\n",
    "print(f\"오늘은 {today.year}년 {today.month}월 {today.day}일입니다.\")\n",
    "\n",
    "my_bday = dt.datetime(today.year, 6, 16)\n",
    "\n",
    "if my_bday < now:\n",
    "    my_bday = dt.datetime(today.year + 1, 6, 16)\n",
    "    \n",
    "gap3 = my_bday - now\n",
    "print(f\"{my_bday.year}년 생일까지는 {gap3.days}일 {gap3.seconds // 3600}시간 남았습니다.\")"
   ]
