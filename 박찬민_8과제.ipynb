   "source": [
    "import math\n",
    "\n",
    "for degree in range(0, 181, 10):\n",
    "    radian = math.radians(degree)\n",
    "    sin_val = math.sin(radian)\n",
    "    \n",
    "    if abs(sin_val) < 1e-10:\n",
    "        sin_val = 0.0\n",
    "        \n",
    "    print(f\"sin({degree:>2}) = {sin_val:.2f}\")"
   ]
