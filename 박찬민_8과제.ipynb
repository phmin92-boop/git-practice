     ]
    }
   ],
   "source": [
    "import datetime as dt\n",
    "\n",
    "now = dt.datetime.now()\n",
    "plus_1000_days = now + dt.timedelta(days=1000)\n",
    "print(f\"오늘로부터 1,000일 후는 {plus_1000_days.year}년 {plus_1000_days.month}월 {plus_1000_days.day}일입니다.\\n\")"
   ]
  },
