   ],
   "source": [
    "## import datetime as dt\n",
    "\n",
    "year, month, day = map(int, input(\"처음으로 사귄 연도와 월, 일을 입력하시오 : \").split())\n",
    "first_day = dt.datetime(year, month, day)\n",
    "\n",
    "hundredth_day = first_day + dt.timedelta(days=99)\n",
    "print(f\"100일 기념일은 : {hundredth_day.year}년 {hundredth_day.month}월 {hundredth_day.day}일입니다.\")"
   ]
  },
